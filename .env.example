# Anthropic API key — for Smart Feed generation (also configurable in Settings UI)
ANTHROPIC_API_KEY=sk-ant-api03-...

# SMTP settings — for weekly email digest (also configurable in Settings UI)
# Gmail: enable 2FA → myaccount.google.com/apppasswords → create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
